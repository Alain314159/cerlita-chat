<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Notas de voz + llamadas (v0.7.0, D75/D76) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- S1/D107: la llamada sobrevive a pantalla apagada/app en background.
         Los tipos mic/cam exigen su runtime permission CONCEDIDO antes del
         startForeground (lo garantiza el flujo de permisos de la UI). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- S1/D107: llamada entrante con pantalla apagada/bloqueada → la
         notificación full-screen prende la pantalla encima del bloqueo. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Timbre Realtime en segundo plano (D63/D64): servicio foreground tipo
         remoteMessaging (sin límite de 6 h de dataSync y permitido arrancar
         desde BOOT_COMPLETED) + receptor de arranque para revivirlo. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- S1/D105: 3ª capa de despertar — alarma ~4-6 min (Doze incluido).
         Sin el permiso especial (Android 13+ no lo da por defecto) degrada
         limpia a setAndAllowWhileIdle: nada rompe. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:name=".ChatApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Chat"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Timbre: WebSocket Realtime permanente; el push SOLO despierta (D63).
             remoteMessaging revive tras reiniciar (FGS_BOOT_COMPLETED_ALLOWLIST). -->
        <service
            android:name=".notify.DoorbellService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging" />

        <receiver
            android:name=".notify.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- N2 (auditoría): revivir el timbre también tras ACTUALIZAR
                     la app sin abrirla. LOCKED_BOOT_COMPLETED queda fuera a
                     propósito: exige directBootAware y todo el stack (DB,
                     vault, prefs) en storage DE — ver D84 en DECISIONES.md -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Acciones de la notificación (D79): responder directo + marcar leído -->
        <receiver
            android:name=".notify.ReplyReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="cu.alain.chat.action.REPLY" />
                <action android:name="cu.alain.chat.action.MARK_READ" />
            </intent-filter>
        </receiver>

        <!-- S1/D107: FGS de la llamada — micrófono + cámara vivos aunque la
             pantalla se apague o la app pase a background. -->
        <service
            android:name=".calls.CallService"
            android:exported="false"
            android:foregroundServiceType="microphone|camera" />

        <!-- S1/D107: acción «Rechazar» de la notificación de llamada entrante -->
        <receiver
            android:name=".calls.CallActionReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- S1/D105: 3ª capa de despertar — alarma que drena ntfy + /sync
             aunque el OEM mate el FGS del timbre. Se replanifica sola. -->
        <receiver
            android:name=".notify.SyncAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- Compartir el export cifrado del historial -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- D62: WorkManager on-demand (ChatApp implementa Configuration.Provider).
             Se retira el inicializador por defecto del androidx.startup para que
             no inicialice dos veces. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
