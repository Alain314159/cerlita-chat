<resources>
    <!-- D120: splash de noche — ciruela muy oscuro (#20191C, D108) para no
         disparar un flash rosa en modo oscuro. El icono viaja en
         drawable-nodpi (idéntico en ambos). -->
    <style name="Theme.Chat" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_cerlita_night</item>
        <item name="android:statusBarColor">@color/splash_bg_night</item>
        <item name="android:navigationBarColor">@color/splash_bg_night</item>
    </style>
</resources>
